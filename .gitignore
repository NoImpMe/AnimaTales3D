# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
AnimaTales3D/[Ll]ibrary/
AnimaTales3D/[Tt]emp/
AnimaTales3D/[Oo]bj/
AnimaTales3D/[Bb]uild/
AnimaTales3D/[Bb]uilds/
AnimaTales3D/[Ll]ogs/
AnimaTales3D/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
AnimaTales3D/[Mm]emoryCaptures/

# Recordings can get excessive in size
AnimaTales3D/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
AnimaTales3D/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
AnimaTales3D/.vs/

# Gradle cache directory
AnimaTales3D/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
AnimaTales3D/ExportedObj/
AnimaTales3D/.consulo/
AnimaTales3D/*.csproj
AnimaTales3D/*.unityproj
AnimaTales3D/*.sln
AnimaTales3D/*.suo
AnimaTales3D/*.tmp
AnimaTales3D/*.user
AnimaTales3D/*.userprefs
AnimaTales3D/*.pidb
AnimaTales3D/*.booproj
AnimaTales3D/*.svd
AnimaTales3D/*.pdb
AnimaTales3D/*.mdb
AnimaTales3D/*.opendb
AnimaTales3D/*.VC.db

# Unity3D generated meta files
AnimaTales3D/*.pidb.meta
AnimaTales3D/*.pdb.meta
AnimaTales3D/*.mdb.meta

# Unity3D generated file on crash reports
AnimaTales3D/sysinfo.txt

# Builds
AnimaTales3D/*.apk
AnimaTales3D/*.aab
AnimaTales3D/*.unitypackage
AnimaTales3D/*.unitypackage.meta
AnimaTales3D/*.app

# Crashlytics generated file
AnimaTales3D/crashlytics-build.properties

# Packed Addressables
AnimaTales3D/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
AnimaTales3D/[Aa]ssets/[Ss]treamingAssets/aa.meta
AnimaTales3D/[Aa]ssets/[Ss]treamingAssets/aa/*

AnimaTales3D/.idea